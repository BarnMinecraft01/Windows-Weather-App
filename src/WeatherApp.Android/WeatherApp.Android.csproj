<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- Android 6.0. Not a preference: androidx.lifecycle.runtime, which
         Avalonia's Android backend depends on, refuses to merge below API 23.
         Still old enough that this is not the thing limiting who can install
         the app. -->
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <RootNamespace>WeatherApp</RootNamespace>
    <AssemblyName>WindowsWeather</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <ApplicationId>com.github.barnminecraft01.windowsweather</ApplicationId>
    <ApplicationVersion>3</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.2</ApplicationDisplayVersion>

    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <!-- One copy of the runtime ships per ABI, and with linking disabled that is
         roughly 35 MB each. arm64 and arm cover every physical Android device at
         API 23 and above; the x86 pair only matters for emulators, so leaving
         them out roughly halves the download. -->
    <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>
    <!-- Endpoints.LoadOverrides reflects over static fields to apply
         endpoints.json, and Avalonia resolves much of its theming by type name,
         so neither survives a trimmer that can only see direct calls.
         PublishTrimmed is the property that actually governs this: a Release
         .NET for Android build turns it on with TrimMode=partial by default.
         AndroidLinkMode is kept for the older toolchain but is a legacy Xamarin
         property, so setting it alone left the app being trimmed. -->
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidLinkMode>None</AndroidLinkMode>
    <!-- Release also turns on ahead-of-time compilation, and the SDK refuses to
         AOT-compile an untrimmed build (XA1030), so the two go together. Losing
         it costs some startup time and adds to the download; both are worth
         paying to find out whether the app runs at all. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Android" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same engine the desktop and WinForms heads compile. Nothing in it
         is platform-specific; see WeatherApp.WinForms.csproj for why this is a
         source glob rather than an assembly reference. -->
    <Compile Include="..\WeatherApp.Core\**\*.cs">
      <Link>Core\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>

    <Compile Include="..\WeatherApp.AvaloniaShared\**\*.cs">
      <Link>Shared\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>

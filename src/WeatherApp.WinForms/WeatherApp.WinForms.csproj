<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{6F2B4C31-9A47-4D5E-8B10-2C7E5A93D001}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>WeatherApp</RootNamespace>
    <AssemblyName>WindowsWeather</AssemblyName>
    <!-- 4.6.2 is the highest version that still installs on Windows 7 SP1, and the
         lowest that enables TLS 1.2 by default. Every endpoint this app uses
         requires TLS 1.2, so this floor is a functional requirement, not a
         preference. -->
    <TargetFrameworkVersion>v4.6.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Prefer 32-bit is off: the radar frames and the jet stream grid are small,
         and a 64-bit process avoids any address space concern on modern machines
         while still running fine as AnyCPU on 32-bit Windows 7. -->
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shared core is compiled straight into this head rather than
         referenced as an assembly. A netstandard2.0 library would be the usual
         answer, but .NET Framework 4.6.2 is missing ~200 of the APIs that
         netstandard2.0 promises and needs binding redirects plus NuGet packages
         to bridge the gap, which would cost this project its "builds from a
         bare checkout with nothing but MSBuild" property. A source glob costs
         nothing and avoids that entirely. -->
    <Compile Include="..\WeatherApp.Core\**\*.cs">
      <Link>Core\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="UI\AlertsPanel.cs" />
    <Compile Include="UI\ForecastPanel.cs" />
    <Compile Include="UI\JetStreamPanel.cs" />
    <Compile Include="UI\LocationPickerForm.cs" />
    <Compile Include="UI\MainForm.cs" />
    <Compile Include="UI\NowPanel.cs" />
    <Compile Include="UI\PrecipitationPanel.cs" />
    <Compile Include="UI\RadarPanel.cs" />
    <Compile Include="UI\Theme.cs" />
    <Compile Include="UI\TrayNotifier.cs" />
    <Compile Include="UI\WeatherPanel.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="App.config" />
    <None Include="app.manifest" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>

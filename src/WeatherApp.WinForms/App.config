<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <!-- useLegacyV2RuntimeActivationPolicy is not needed; sku pins the minimum
         runtime so Windows offers to install .NET Framework if it is missing. -->
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.2" />
  </startup>
  <runtime>
    <!-- Windows 7 / 8 ship with SChannel defaults that predate TLS 1.2.
         These switches make sure the modern protocol list is used; the code in
         HttpService also sets ServicePointManager.SecurityProtocol explicitly. -->
    <AppContextSwitchOverrides value="Switch.System.Net.DontEnableSchUseStrongCrypto=false;Switch.System.Net.DontEnableSystemDefaultTlsVersions=false" />
  </runtime>
  <system.net>
    <settings>
      <httpWebRequest useUnsafeHeaderParsing="true" />
    </settings>
    <connectionManagement>
      <add address="*" maxconnection="12" />
    </connectionManagement>
  </system.net>
</configuration>
